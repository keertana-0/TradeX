# PostgreSQL Database URL (Neon, Supabase, Vercel Postgres, or local PostgreSQL)
# Example: postgresql://user:password@ep-cool-frost-123456.ap-southeast-1.aws.neon.tech/tradex?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradex?schema=public"

# Authentication Secret (minimum 32 characters for JOSE HS256)
AUTH_SECRET="tradex_super_secret_session_jwt_key_at_least_32_chars_2026"

# Market Data Configuration
# Values: "live" | "development"
# In "live" mode: only real provider data is used; missing/invalid credentials will fail safely.
# In "development" mode: deterministic offline market fixtures are provided for local dev & tests.
MARKET_DATA_MODE="development"
MARKET_DATA_API_KEY=""
MARKET_DATA_API_URL="https://query1.finance.yahoo.com"

# Admin Initial Seed (used on npm run db:seed)
ADMIN_EMAIL="admin@tradex.local"
ADMIN_PASSWORD="AdminSecurePassword123!"

# Application Port
PORT=3000

# Optional override for the historical NIFTY CSV directories. Defaults to data/historical-options inside TradeX.
# TRADEX_HISTORICAL_OPTIONS_DIR=C:/path/to/historical-options

# Optional: point Next.js to a separately hosted Python stock-analysis service.
# If unset, the backtest starts the local services/stock-analysis Python environment.
# JUGAAD_HISTORICAL_API_URL="http://127.0.0.1:5000"
# Set the same random token in both services when exposing the Python endpoint.
# JUGAAD_HISTORICAL_API_TOKEN=""
# PYTHON_EXECUTABLE="C:/path/to/python.exe"

# Upstox 1-minute option candle history for intraday stop/target simulation.
# Expired contract candles require an Upstox Plus subscription; access tokens must be refreshed per Upstox OAuth policy.
UPSTOX_ACCESS_TOKEN=""

# Yahoo Finance index candles. Allowed values: 1 through 60 minutes; default is 5.
STRATEGY_AGENT_TIMEFRAME_MINUTES=5
# Live paper options for NIFTY, BANKNIFTY, and SENSEX require a valid Upstox market-data token.
STRATEGY_OPTION_MIN_CONFIDENCE=0.55
STRATEGY_OPTION_ENTRY_START_IST=09:20
STRATEGY_OPTION_MAX_SPREAD_PCT=0.05
STRATEGY_OPTION_STOP_LOSS_PCT=0.25
STRATEGY_OPTION_TARGET_PCT=0.40

# Telegram trade notifications and startup online messages. Create fresh bot tokens and set the destination chat ID.
# Bots 1–9 map to PHANTOM, BREACH, VANGUARD, ORACLE, ECLIPSE, PULSE, SENTINEL, VOLT, and SPECTRE.
# Comma-separated chat destinations. If empty, the legacy single chat ID is used.
TRADEX_TELEGRAM_CHAT_IDS=""
TRADEX_TELEGRAM_CHAT_ID=""
TRADEX_TELEGRAM_AGENT_1_TOKEN=""
TRADEX_TELEGRAM_AGENT_2_TOKEN=""
TRADEX_TELEGRAM_AGENT_3_TOKEN=""
TRADEX_TELEGRAM_AGENT_4_TOKEN=""
TRADEX_TELEGRAM_AGENT_5_TOKEN=""
TRADEX_TELEGRAM_AGENT_6_TOKEN=""
TRADEX_TELEGRAM_AGENT_7_TOKEN=""
TRADEX_TELEGRAM_AGENT_8_TOKEN=""
TRADEX_TELEGRAM_AGENT_9_TOKEN=""
