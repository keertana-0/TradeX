{
  "name": "tradex",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "python:install": "node scripts/python-env.js install",
    "python:start": "node scripts/python-env.js start",
    "python:test": "node scripts/python-env.js test",
    "backtest:strategy-agents": "node scripts/run-strategy-backtest.cjs"
    ,"desktop:dev": "npm run build && electron ."
    ,"desktop:package": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "jose": "^5.9.6",
    "lucide-react": "^0.462.0",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.tradex.desktop",
    "productName": "TradeX",
    "directories": { "output": "release" },
    "asar": false,
    "files": ["desktop/**/*", "package.json", "node_modules/**/*"],
    "extraResources": [
      { "from": ".next/standalone", "to": "tradex" },
      { "from": ".next/static", "to": "tradex/.next/static" },
      { "from": "public", "to": "tradex/public", "filter": ["**/*"] },
      { "from": "prisma/schema.prisma", "to": "tradex/prisma/schema.prisma" },
      { "from": "prisma/seed.ts", "to": "tradex/prisma/seed.ts" },
      { "from": "data/historical-options", "to": "tradex/data/historical-options", "filter": ["**/*"] },
      { "from": "data/strategy-backtests/independent-strategy-results.json", "to": "tradex/data/strategy-backtests/independent-strategy-results.json" }
    ],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
